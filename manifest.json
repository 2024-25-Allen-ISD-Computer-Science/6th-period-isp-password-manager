{
  "manifest_version": 3,
  "name": "Password Manager",
  "description": "Store and manage your passwords securely",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "lock.png"
  },
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}
