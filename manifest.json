{
  "manifest_version": 2,
  "name": "Password Manager",
  "description": "Store and manage your passwords securely",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "lock.png"
  }
}
