{
  "manifest_version": 3,
  "name": "Guardify",
  "description": "Base Level Extension",
  "version": "1.0",
  "icons": {
    "128": "lock.png"
  },
  "action": {
    "default_popup": "main-page.html",
    "default_icon": "lock.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"]
    }
  ]
}